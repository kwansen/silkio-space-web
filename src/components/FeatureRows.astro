---
// Alternating feature rows — text on one side, UI mockup on the other,
// alternating direction. Mockups live in ./demos.
import FastCreateDemo from "./demos/FastCreateDemo.vue";
import DocTypeDemo from "./demos/DocTypeDemo.vue";
import SearchDemo from "./demos/SearchDemo.vue";
import SortDemo from "./demos/SortDemo.vue";
import ArchiveDemo from "./demos/ArchiveDemo.vue";
import EditorStaticMockup from "./demos/EditorStaticMockup.astro";
import SearchStaticMockup from "./demos/SearchStaticMockup.astro";
import SortStaticMockup from "./demos/SortStaticMockup.astro";
import ArchiveStaticMockup from "./demos/ArchiveStaticMockup.astro";

interface Feature {
  title: string;
  desc: string;
  link: string;
  visual:
    | "capture"
    | "editor"
    | "editorStatic"
    | "search"
    | "searchStatic"
    | "sort"
    | "sortStatic"
    | "archive"
    | "archiveStatic";
}

interface Props {
  features: Feature[];
}

const { features } = Astro.props;
---

{features.map((f, i) => (
  <section
    class={`w-full py-16 md:py-24 ${i % 2 === 1 ? "bg-canvas" : "bg-white"}`}
  >
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-6 md:grid-cols-3 md:gap-14">
      {/* Text column — narrower, order alternates per row */}
      <div class={`${i % 2 === 1 ? "md:order-2" : ""}`}>
        <h2 class="font-display text-[26px] font-semibold text-carbon md:text-[34px]">
          {f.title}
        </h2>
        <p class="mt-4 max-w-md text-base leading-relaxed text-pewter">
          {f.desc}
        </p>
        <a
          href="#"
          class="tds-transition mt-6 inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline"
        >
          {f.link}
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M9 18l6-6-6-6" />
          </svg>
        </a>
      </div>
      {/* Visual column — 2/3 width */}
      <div class={`${i % 2 === 1 ? "md:order-1" : ""} md:col-span-2`}>
        {f.visual === "capture" && <FastCreateDemo client:visible />}
        {f.visual === "editor" && <DocTypeDemo client:visible />}
        {f.visual === "editorStatic" && <EditorStaticMockup />}
        {f.visual === "search" && <SearchDemo client:visible />}
        {f.visual === "searchStatic" && <SearchStaticMockup />}
        {f.visual === "sort" && <SortDemo client:visible />}
        {f.visual === "sortStatic" && <SortStaticMockup />}
        {f.visual === "archive" && <ArchiveDemo client:visible />}
        {f.visual === "archiveStatic" && <ArchiveStaticMockup />}
      </div>
    </div>
  </section>
))}
