---
const groups = [
  {
    title: "产品",
    links: ["产品概览", "功能特性", "定价", "更新日志"],
  },
  {
    title: "解决方案",
    links: ["行业方案", "开发者", "合作伙伴"],
  },
  {
    title: "支持",
    links: ["帮助中心", "文档", "状态页", "联系我们"],
  },
  {
    title: "关于",
    links: ["公司介绍", "加入我们", "新闻", "法律条款"],
  },
];
---

<footer class="bg-ash px-6 py-12">
  <div class="mx-auto max-w-345.75">
    <p class="text-xs text-pewter">
      思刻空间 —— 思之所至，刻之即成。快速创建、快速检索，让心流不断线。
    </p>
    <div class="mt-8 grid grid-cols-2 gap-8 md:grid-cols-4">
      {groups.map((g) => (
        <div>
          <h3 class="text-sm font-medium text-carbon">{g.title}</h3>
          <ul class="mt-3 space-y-2">
            {g.links.map((l) => (
              <li>
                <a
                  href="#"
                  class="text-sm font-normal text-pewter hover:underline"
                >
                  {l}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="mt-10 text-xs text-fog">
      © 2026 Silkio Space. All rights reserved.
    </p>
  </div>
</footer>
