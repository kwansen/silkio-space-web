---
// Software-style hero: headline + CTAs + product UI mockup (pure CSS, no images).
interface Props {
  title: string;
  subtitle?: string;
  primary?: string;
  secondary?: string;
}

const {
  title,
  subtitle,
  primary = "立即体验",
  secondary = "查看功能",
} = Astro.props;

const bars = [42, 68, 30, 82, 55, 74, 48, 90, 60];
---

<section class="w-full bg-canvas pt-28 pb-16 md:pt-36 md:pb-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-3xl text-center">
      <p class="text-sm font-medium text-primary">Silkio Space</p>
      <h1 class="mt-3 font-display text-[32px] font-semibold leading-tight text-carbon md:text-[48px]">
        {title}
      </h1>
      {subtitle && (
        <p class="mx-auto mt-4 max-w-xl text-base text-pewter md:text-lg">
          {subtitle}
        </p>
      )}
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a
          href="#"
          class="tds-transition flex h-11 w-48 items-center justify-center rounded-btn bg-primary text-sm font-medium text-white hover:bg-[#3457b1]"
        >
          {primary}
        </a>
        <a
          href="#features"
          class="tds-transition flex h-11 w-40 items-center justify-center rounded-btn border border-hairline bg-white text-sm font-medium text-carbon hover:border-graphite"
        >
          {secondary}
        </a>
      </div>
    </div>

    <!-- Product screenshot in browser frame -->
    <div class="relative mx-auto mt-14 max-w-5xl">
      <div class="absolute -inset-8 rounded-[40px] bg-linear-to-br from-primary/15 via-transparent to-primary/5 blur-3xl"></div>
      <div class="relative overflow-hidden rounded-card border border-hairline bg-white shadow-[0_32px_80px_-24px_rgba(23,26,32,0.28)]">
        <div class="flex items-center gap-2 border-b border-hairline bg-ash px-4 py-2.5">
          <span class="h-2.5 w-2.5 rounded-full bg-[#ff5f57]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#febc2e]"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-[#28c840]"></span>
          <div class="ml-3 hidden h-5 flex-1 items-center rounded bg-white px-3 text-[10px] text-fog sm:flex">
            app.silkiospace.com
          </div>
        </div>
        <img
          src="/images/hero/app-overview.png"
          alt="思刻空间产品界面总览"
          class="w-full bg-canvas"
          fetchpriority="high"
        />
      </div>
    </div>
  </div>
</section>
