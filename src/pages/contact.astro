---
import PageLayout from "../layouts/PageLayout.astro";
import Wechat from "../icons/Wechat.vue";
import Mail from "../icons/Mail.vue";

const channels = [
  {
    name: "微信",
    value: "kwanseninf",
    icon: Wechat,
  },
  {
    name: "邮箱",
    value: "feedback@silkio.cn",
    icon: Mail,
  },
];
---

<PageLayout title="联系我们 - Silkio Space">
  <fragment slot="title">联系我们</fragment>
  <fragment slot="intro">
    有问题、建议，或者只是想说声你好？欢迎随时联系，我们会尽快回复。
  </fragment>

  <div class="grid gap-6 md:grid-cols-2">
    {channels.map((c) => (
      <div class="rounded-card border border-hairline bg-white p-6">
        {c.icon && (
          <c.icon class="mb-3 text-2xl text-primary" aria-hidden="true" />
        )}
        <h2 class="text-sm font-medium text-carbon">{c.name}</h2>
        <button
          type="button"
          data-copy={c.value}
          class="tds-transition mt-2 block cursor-pointer text-base text-primary hover:underline"
          title="点击复制"
        >
          {c.value}
        </button>
      </div>
    ))}
  </div>
</PageLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy;
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        const original = btn.textContent;
        btn.textContent = "已复制";
        setTimeout(() => {
          btn.textContent = original;
        }, 1500);
      } catch {
        window.prompt("复制失败，请手动复制：", text);
      }
    });
  });
</script>
