---
import PageLayout from "../layouts/PageLayout.astro";
import ExternalLink from "../icons/ExternalLink.vue";

const products = [
  {
    name: "思刻思维导图",
    desc: "免费在线思维导图，无需登录即可使用，支持 AI 辅助生成。",
    href: "https://mindmap.silkio.cn/",
  },
  {
    name: "思刻流程图",
    desc: "免费在线流程图，无需登录即可使用，支持 AI 辅助绘制。",
    href: "https://flowchart.silkio.cn/",
  },
];
---

<PageLayout title="其他产品 - Silkio Space">
  <fragment slot="title">其他产品</fragment>
  <fragment slot="intro">思刻空间之外，我们也有以下产品。</fragment>

  <ul class="mt-2 border-t border-neutral-100">
    {products.map((p) => (
      <li class="border-b border-neutral-100 hover:bg-gray-50 px-4">
        <a
          href={p.href}
          target="_blank"
          rel="noopener noreferrer"
          class="grid h-16 grid-cols-[1fr_auto] items-center gap-4 cursor-pointer"
        >
          <div class="min-w-0 flex flex-col justify-center py-2">
            <div class="truncate text-sm font-medium text-carbon">{p.name}</div>
            <div class="truncate text-xs text-neutral-400">{p.desc}</div>
          </div>
          <ExternalLink class="size-4 text-base text-neutral-400" />
        </a>
      </li>
    ))}
  </ul>
</PageLayout>
