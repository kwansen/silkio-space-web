---
import PageLayout from "../layouts/PageLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<PageLayout title="博客 - Silkio Space">
  <fragment slot="title">博客</fragment>
  <fragment slot="intro">
    产品思考、设计决策与开发札记，记录思刻空间是如何一步步长出来的。
  </fragment>

  <ul class="mt-2 border-t border-neutral-100">
    {
      posts.map((p) => (
        <li class="border-b border-neutral-100">
          <a
            href={`/blog/${p.id}/`}
            class="tds-transition group grid h-16 grid-cols-[1fr_auto] items-center gap-4 hover:bg-neutral-50"
          >
            <div class="min-w-0 flex flex-col justify-center py-2 pl-2">
              <div class="truncate text-sm font-medium text-carbon group-hover:text-primary">
                {p.data.title}
              </div>
              <div class="truncate text-xs text-neutral-400">
                {p.data.excerpt}
              </div>
            </div>
            <time
              class="whitespace-nowrap px-4 text-right text-xs text-neutral-400"
              datetime={p.data.date.toISOString()}
            >
              {p.data.date.toISOString().slice(0, 10)}
            </time>
          </a>
        </li>
      ))
    }
  </ul>
</PageLayout>
