---
import PageLayout from "../layouts/PageLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<PageLayout title="博客 - Silkio Space">
  <fragment slot="title">博客</fragment>
  <fragment slot="intro">
    产品思考、设计决策与开发札记，记录思刻空间是如何一步步长出来的。
  </fragment>

  <ul class="space-y-6">
    {
      posts.map((p) => (
        <li>
          <a
            href={`/blog/${p.id}/`}
            class="tds-transition block rounded-card border border-hairline bg-white p-6 hover:border-primary/40"
          >
            <div class="flex items-baseline justify-between gap-4">
              <h2 class="text-lg font-medium text-carbon">{p.data.title}</h2>
              <time class="shrink-0 text-xs text-fog" datetime={p.data.date.toISOString()}>
                {p.data.date.toISOString().slice(0, 10)}
              </time>
            </div>
            <p class="mt-2 text-sm leading-relaxed text-pewter">{p.data.excerpt}</p>
            <p class="mt-3 text-xs text-fog">{p.data.author}</p>
          </a>
        </li>
      ))
    }
  </ul>
</PageLayout>
