---
import PageLayout from "../layouts/PageLayout.astro";
import RegisterForm from "../components/RegisterForm.vue";
---

<PageLayout
  title="注册账号 - Silkio Space"
  description="注册 Silkio Space 账号，在桌面客户端登录后即可使用云同步。"
>
  <fragment slot="title">注册账号</fragment>
  <fragment slot="intro">
    注册后即可在桌面客户端登录。云同步权限需要单独开通。
  </fragment>

  <RegisterForm client:load />
</PageLayout>
